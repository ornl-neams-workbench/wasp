#!/usr/bin/env python

"""
setup.py file for WASP
"""

from pathlib import Path
from shutil import copy2
from setuptools import setup, Extension
from setuptools.command.build_ext import build_ext

# read the contents of your README file
this_directory = Path(__file__).parent
long_description = (this_directory / "README.md").read_text(encoding="utf-8")

prebuilt_extension = Path(r"$<TARGET_FILE:_wasp>")


class CMakeBuildExt(build_ext):
    """Install the extension already compiled and linked by CMake."""

    def build_extension(self, ext):
        destination = Path(self.get_ext_fullpath(ext.name))
        destination.parent.mkdir(parents=True, exist_ok=True)
        copy2(prebuilt_extension, destination)

wasp_module = Extension('_wasp',
                           sources=[],
                           py_limited_api=True, 
                           )

setup (name = 'ornl-wasp',
       version = "${${PROJECT_NAME}_VERSION}",
       description = "Python bindings for parsing and validating WASP input formats",
       author ="Shane Henderson, Robert A. Lefebvre, Brandon R. Langley",
       author_email="hendersonsc@ornl.gov, lefebvrera@ornl.gov",
       url="https://code.ornl.gov/neams-workbench/wasp",
       project_urls = {
           "Documentation": "https://code.ornl.gov/neams-workbench/wasp/-/blob/master/wasppy/README.md",
           "Source": "https://code.ornl.gov/neams-workbench/wasp",
           "Issues": "https://code.ornl.gov/neams-workbench/wasp/-/issues",
           "Changelog": "https://code.ornl.gov/neams-workbench/wasp/-/blob/master/CHANGELOG.md",
       },
       keywords = [
           "parser",
           "validation",
           "SON",
           "HIT",
           "DDI",
           "EDDI",
           "ORNL",
       ],
       classifiers = [
           "Intended Audience :: Developers",
           "Intended Audience :: Science/Research",
           "Operating System :: MacOS :: MacOS X",
           "Operating System :: Microsoft :: Windows",
           "Operating System :: POSIX :: Linux",
           "Programming Language :: C++",
           "Programming Language :: Python :: 3",
           "Programming Language :: Python :: 3.10",
           "Programming Language :: Python :: 3.11",
           "Programming Language :: Python :: 3.12",
           "Programming Language :: Python :: 3.13",
           "Programming Language :: Python :: 3.14",
           "Topic :: Scientific/Engineering",
           "Topic :: Software Development :: Libraries :: Python Modules",
           "Topic :: Text Processing",
       ],
       ext_modules = [wasp_module],
       cmdclass = {"build_ext": CMakeBuildExt},
       py_modules = ["wasp", "Database", "sch2db", "db2doc"],
       python_requires = ">=3.10",
       long_description=long_description,
       long_description_content_type='text/markdown',
       license_files = ["LICENSE"]
       )
