IF(CPACK_GENERATOR STREQUAL "NSIS")
  SET(CPACK_NSIS_PACKAGE_NAME "WASP ${CPACK_PACKAGE_VERSION}")
  SET(CPACK_NSIS_DISPLAY_NAME "WASP ${CPACK_PACKAGE_VERSION}")
  SET(CPACK_NSIS_MODIFY_PATH ON)
ELSEIF(CPACK_GENERATOR STREQUAL "STGZ")
  SET(CPACK_ARCHIVE_COMPONENT_INSTALL ON)
  SET(CPACK_COMPONENTS_GROUPING ALL_COMPONENTS_IN_ONE)
ELSEIF(CPACK_GENERATOR STREQUAL "productbuild")
  SET(CPACK_PACKAGING_INSTALL_PREFIX "/usr/local")
  SET(CPACK_PRODUCTBUILD_IDENTIFIER "gov.ornl.wasp")
ENDIF()
